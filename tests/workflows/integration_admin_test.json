        "jsCode": "const items = $input.all().map((item) => item.json);\nconst json = items[0];\nconst check = (ok, what) => { if (!ok) throw new Error(`Check Create Base: ${what}: ${JSON.stringify(items)}`); };\ncheck(json.name === 'admin_test' && json.type === 'base' && json.id, 'wrong collection');\ncheck(json.fields.some((f) => f.name === 'note'), 'field missing');\nreturn [{ json }];"
