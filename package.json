{
  "name": "n8n-nodes-pocketbase",
  "version": "2.40.3",
  "description": "Interact with your PocketBase instance",
  "keywords": [
    "n8n-community-node-package"
  ],
  "homepage": "https://github.com/TheFehr/n8n-nodes-pocketbase#readme",
  "license": "MIT",
  "author": {
    "name": "Philipp Fehr",
    "email": "philipp@thefehr.ch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheFehr/n8n-nodes-pocketbase.git"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "n8n-node build && node scripts/bundle-vendor-deps.mjs",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:pipeline": "bash scripts/full-test.sh",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "lint:oxlint": "oxlint"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.56.0",
    "@release-it/conventional-changelog": "^12.0.0",
    "esbuild": "^0.28.1",
    "eventsource": "^5.0.0",
    "form-data": "^4.0.5",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.93.0",
    "release-it": "^21.0.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vite": "^8.0.8",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/PocketbaseHttpApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/PocketbaseHttp/PocketbaseHttp.node.js",
      "dist/nodes/PocketbaseTrigger/PocketbaseTrigger.node.js"
    ]
  },
  "n8nNodeTooling": {
    "upstream": {
      "name": "PocketBase",
      "source": {
        "type": "github",
        "repo": "pocketbase/pocketbase"
      },
      "track": {
        "type": "field",
        "name": "pocketbaseVersion"
      },
      "majorOffset": 2
    },
    "readme": "Last tested with n8n {n8n} and PocketBase {upstream}.",
    "pins": {
      "pocketbase": {
        "file": "docker-compose.test.yml",
        "template": "image: ghcr.io/muchobien/pocketbase:{version}",
        "from": "upstream"
      },
      "n8n": {
        "file": "docker-compose.test.yml",
        "template": "image: n8nio/n8n:{version}",
        "from": "n8n"
      }
    }
  },
  "n8nWorkflowVersion": "2.47.1",
  "pocketbaseVersion": "0.40.6"
}
